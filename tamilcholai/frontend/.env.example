# Firebase Configuration for Tamilcholai
# Get these credentials from your Firebase Console: https://console.firebase.google.com
# 1. Create a Firebase project
# 2. Add a Web App (</>)
# 3. Copy the firebaseConfig keys into this file and rename it to .env.local or .env

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Set to "true" to enable local demo fallback with rich pre-seeded data when Firebase keys are not yet configured
VITE_ENABLE_DEMO_FALLBACK=true
